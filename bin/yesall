#!/bin/sh
# yesall:managed
set -eu

self_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
if [ -d "$self_dir/../providers" ]; then
    provider_dir=$(CDPATH='' cd -- "$self_dir/../providers" && pwd)
else
    provider_dir=$self_dir
fi

field() {
    key=$1
    file=$2
    sed -n "s/^# yesall:$key=//p" "$file"
}

list() {
    printf '%-6s %-22s %s\n' SHORT NAME LAUNCH
    for file in "$provider_dir"/*; do
        [ -f "$file" ] || continue
        [ "$(field kind "$file")" = provider ] || continue
        shortcut=${file##*/}
        name=$(field name "$file")
        binary=$(field binary "$file")
        prefix=$(field prefix "$file")
        env_value=$(field env "$file")
        launch=$binary
        [ -n "$prefix" ] && launch="$launch $prefix"
        [ -n "$env_value" ] && launch="$env_value $launch"
        printf '%-6s %-22s %s\n' "$shortcut" "$name" "$launch"
    done
}

doctor() {
    status=0
    for file in "$provider_dir"/*; do
        [ -f "$file" ] || continue
        [ "$(field kind "$file")" = provider ] || continue
        shortcut=${file##*/}
        name=$(field name "$file")
        binary=$(field binary "$file")
        if command -v "$binary" >/dev/null 2>&1; then
            printf 'ok       %-6s %s\n' "$shortcut" "$name"
        else
            printf 'missing  %-6s %s (%s)\n' "$shortcut" "$name" "$binary"
            status=1
        fi
    done
    return "$status"
}

update() {
    raw_base=${YESALL_RAW_BASE:-https://raw.githubusercontent.com/minodevss/yesall/main}
    if ! command -v curl >/dev/null 2>&1; then
        printf 'yesall: curl is required to update\n' >&2
        return 1
    fi
    tmp_file=$(mktemp "${TMPDIR:-/tmp}/yesall-install.XXXXXX")
    trap 'rm -f "$tmp_file"' EXIT HUP INT TERM
    curl -fsSL "$raw_base/install.sh" -o "$tmp_file"
    sh "$tmp_file"
}

usage='Usage: yesall [list|doctor|update]'

case ${1:-list} in
    list)
        list
        ;;
    doctor)
        doctor
        ;;
    update)
        update
        ;;
    -h|--help|help)
        printf '%s\n' "$usage"
        ;;
    *)
        printf 'yesall: unknown command: %s\n' "$1" >&2
        printf '%s\n' "$usage" >&2
        exit 2
        ;;
esac
